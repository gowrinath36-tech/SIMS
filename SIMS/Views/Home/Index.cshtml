@{
    Layout = "_Layout";
    ViewData["Title"] = "SecureIMS Portal";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<style>
    /* Premium Header Section */
    .portal-hero {
        padding: 80px 0 60px;
        text-align: center;
        background: radial-gradient(circle at top, #f8fafc 0%, #f1f5f9 100%);
        border-radius: 0 0 50px 50px;
        margin-bottom: 40px;
    }

        .portal-hero h1 {
            font-weight: 800;
            color: #0f172a; /* Slate 900 */
            letter-spacing: -1.5px;
            font-size: 3rem;
            margin-bottom: 15px;
        }

        .portal-hero p {
            color: #64748b;
            font-size: 1.2rem;
            max-width: 600px;
            margin: 0 auto;
        }

    /* Modern Portal Cards */
    .portal-card {
        border: 1px solid #e2e8f0;
        border-radius: 24px;
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        background: white;
        text-align: center;
        padding: 50px 30px;
        height: 100%;
        position: relative;
        overflow: hidden;
    }

        /* Subtle Background Glow for Cards */
        .portal-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 5px;
            transition: height 0.3s ease;
        }

    .card-reporter::before {
        background: #3b82f6;
    }

    .card-investigator::before {
        background: #f59e0b;
    }

    .card-admin::before {
        background: #ef4444;
    }

    .portal-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 30px 60px -12px rgba(15, 23, 42, 0.12);
        border-color: transparent;
    }

    /* Icon Styling */
    .icon-box {
        width: 80px;
        height: 80px;
        margin: 0 auto 25px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
        transition: all 0.3s ease;
    }

    .card-reporter .icon-box {
        background: #eff6ff;
        color: #3b82f6;
    }

    .card-investigator .icon-box {
        background: #fffbeb;
        color: #f59e0b;
    }

    .card-admin .icon-box {
        background: #fef2f2;
        color: #ef4444;
    }

    .portal-card:hover .icon-box {
        transform: scale(1.1) rotate(5deg);
    }

    /* Typography & Buttons */
    .portal-card h3 {
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 15px;
    }

    .btn-portal {
        border-radius: 12px;
        padding: 12px 30px;
        font-weight: 700;
        font-size: 0.9rem;
        border: none;
        transition: all 0.3s;
        width: 100%;
    }

    .btn-reporter {
        background: #3b82f6;
        color: white;
    }

    .btn-investigator {
        background: #f59e0b;
        color: white;
    }

    .btn-admin {
        background: #ef4444;
        color: white;
    }

    .btn-portal:hover {
        filter: brightness(90%);
        transform: scale(1.02);
        color: white;
    }
</style>

<div class="portal-hero animate__animated animate__fadeIn">
    <h1 class="animate__animated animate__slideInDown">SecureTrack <span class="text-primary">Portal</span></h1>
    <p class="animate__animated animate__fadeIn animate__delay-1s">
        A centralized intelligence environment for secure reporting, active investigation, and administrative oversight.
    </p>
</div>

<div class="container pb-5">
    <div class="row g-4 justify-content-center">

        <div class="col-md-4 animate__animated animate__fadeInUp animate__delay-1s">
            <div class="portal-card card-reporter">
                <div class="icon-box">
                    <i class="bi bi-person-badge"></i>
                </div>
                <h3>Reporter</h3>
                <p>Submit new security incidents, provide evidence, and monitor the resolution status of your cases in real-time.</p>
                <a asp-controller="Account" asp-action="ReporterLogin" class="btn btn-portal btn-reporter shadow-sm">
                    Access Reporter Portal
                </a>
            </div>
        </div>

        <div class="col-md-4 animate__animated animate__fadeInUp animate__delay-2s">
            <div class="portal-card card-investigator">
                <div class="icon-box">
                    <i class="bi bi-search-heart"></i>
                </div>
                <h3>Investigator</h3>
                <p>Manage high-priority assignments, conduct deep-dive investigations, and maintain secure case logs.</p>
                <a asp-controller="Account" asp-action="InvestigatorLogin" class="btn btn-portal btn-investigator shadow-sm">
                    Access Investigator Portal
                </a>
            </div>
        </div>

        <div class="col-md-4 animate__animated animate__fadeInUp animate__delay-3s">
            <div class="portal-card card-admin">
                <div class="icon-box">
                    <i class="bi bi-shield-lock"></i>
                </div>
                <h3>Administrator</h3>
                <p>Oversee total system operations, manage role-based access control, and analyze department performance.</p>
                <a asp-controller="Account" asp-action="AdminLogin" class="btn btn-portal btn-admin shadow-sm">
                    Access Admin Portal
                </a>
            </div>
        </div>

    </div>
</div>