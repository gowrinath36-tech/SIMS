@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SecureIMS</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --primary-dark: #0f172a; /* Slate 900 */
            --accent-blue: #3b82f6; /* Modern Blue */
            --bg-soft: #f8fafc; /* Slate 50 */
        }

        body {
            background-color: var(--bg-soft);
            font-family: 'Inter', sans-serif;
            color: #334155;
        }

        /* Modern Glass Navbar */
        .navbar {
            background-color: rgba(255, 255, 255, 0.9) !important;
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(0,0,0,0.05) !important;
            padding: 0.8rem 0;
        }

        .navbar-brand {
            letter-spacing: -0.5px;
            font-size: 1.4rem;
        }

        .nav-link {
            font-weight: 500;
            color: #64748b !important;
            transition: all 0.2s ease;
            margin: 0 5px;
        }

            .nav-link:hover {
                color: var(--accent-blue) !important;
                transform: translateY(-1px);
            }

        /* Active Role Badge */
        .username-badge {
            background: white;
            padding: 6px 16px;
            border-radius: 12px;
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--primary-dark);
            box-shadow: 0 2px 5px rgba(0,0,0,0.04);
            border: 1px solid #e2e8f0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* Main Content Animation */
        main {
            animation: fadeIn 0.5s ease-in-out;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .footer {
            background: transparent !important;
            border: none !important;
            font-size: 0.85rem;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light sticky-top mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold text-dark" asp-controller="Home" asp-action="Index">
                    <span class="text-primary"><i class="bi bi-shield-lock-fill"></i></span> SecureIMS
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @{
                            var session = HttpContextAccessor.HttpContext?.Session;
                            var role = session?.GetString("RID");
                            var uName = session?.GetString("UName");
                        }

                        @if (!string.IsNullOrEmpty(role))
                        {
                            <li class="nav-item">
                                @if (role == "1")
                                {
                                    <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">
                                        <i class="bi bi-grid-1x2-fill me-1"></i> Dashboard
                                    </a>
                                }
                                else if (role == "2")
                                {
                                    <a class="nav-link" asp-controller="Reporter" asp-action="MyReports">
                                        <i class="bi bi-file-earmark-text-fill me-1"></i> My Reports
                                    </a>
                                }
                                else if (role == "3")
                                {
                                    <a class="nav-link" asp-controller="Investigator" asp-action="MyTasks">
                                        <i class="bi bi-clipboard-check-fill me-1"></i> My Tasks
                                    </a>
                                }
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        @if (!string.IsNullOrEmpty(uName))
                        {
                            <div class="username-badge">
                                <i class="bi bi-person-circle text-primary"></i>
                                <span>@uName</span>
                            </div>

                            <a class="btn btn-sm btn-dark px-3 fw-semibold rounded-3"
                               asp-controller="Account" asp-action="Logout">
                                Logout
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted text-center py-4 mt-auto">
        <div class="container">
            <p class="mb-0">&copy; @DateTime.Now.Year — <strong>SecureIMS</strong> Management System</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>